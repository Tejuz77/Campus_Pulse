// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("STUDENT") // STUDENT | STAFF | ADMIN
  rollNo       String?  @map("roll_no")
  departmentId String?  @map("department_id")
  isActive     Boolean  @default(true) @map("is_active")
  onLeave      Boolean  @default(false) @map("on_leave")
  createdAt    DateTime @default(now()) @map("created_at")

  department        Department?    @relation(fields: [departmentId], references: [id])
  reports           Report[]       @relation("ReporterReports")
  assignments       Assignment[]   @relation("AssignedToUser")
  assignedBy        Assignment[]   @relation("AssignedByUser")
  issueUpdates      IssueUpdate[]
  attachments       Attachment[]
  auditLogs         AuditLog[]
  feedbacks         Feedback[]
  notifications     Notification[]
  proposedLocations Location[]     @relation("ProposedLocations")

  @@map("users")
}

model Department {
  id               String  @id @default(cuid())
  name             String  @unique
  type             String // academic | service
  contactReference String? @map("contact_reference")
  isActive         Boolean @default(true) @map("is_active")

  users          User[]
  incidents      Incident[]
  categories     Category[]
  ownedLocations Location[] @relation("OwnedLocations")

  @@map("departments")
}

model Category {
  id                  String  @id @default(cuid())
  name                String  @unique
  defaultDepartmentId String? @map("default_department_id")
  isDepartmentOwned   Boolean @default(false) @map("is_department_owned")
  defaultPriority     String  @default("MEDIUM") @map("default_priority")
  isSafety            Boolean @default(false) @map("is_safety")
  isActive            Boolean @default(true) @map("is_active")

  defaultDepartment Department? @relation(fields: [defaultDepartmentId], references: [id])
  reports           Report[]
  incidents         Incident[]

  @@map("categories")
}

model Location {
  id                String  @id @default(cuid())
  block             String?
  floor             Int?
  name              String
  type              String // classroom | lab | washroom | corridor | other
  systemCount       Int?    @map("system_count")
  ownerDepartmentId String? @map("owner_department_id")
  status            String  @default("approved") // approved | pending | rejected
  proposedById      String? @map("proposed_by")
  isActive          Boolean @default(true) @map("is_active")
  rejectedReason    String? @map("rejected_reason")

  ownerDepartment Department? @relation("OwnedLocations", fields: [ownerDepartmentId], references: [id])
  proposedBy      User?       @relation("ProposedLocations", fields: [proposedById], references: [id])
  reports         Report[]
  incidents       Incident[]

  @@index([block, floor])
  @@map("locations")
}

model Incident {
  id                     String    @id @default(cuid())
  summary                String
  categoryId             String    @map("category_id")
  locationId             String    @map("location_id")
  departmentId           String?   @map("department_id")
  priority               String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status                 String    @default("SUBMITTED") // SUBMITTED | ASSIGNED | IN_PROGRESS | AWAITING_CONFIRMATION | RESOLVED | ON_HOLD | REJECTED | REOPENED
  escalated              Boolean   @default(false)
  version                Int       @default(0)
  createdAt              DateTime  @default(now()) @map("created_at")
  closedAt               DateTime? @map("closed_at")
  holdReason             String?   @map("hold_reason")
  holdReviewDate         DateTime? @map("hold_review_date")
  holdNextAction         String?   @map("hold_next_action")
  awaitingConfirmationAt DateTime? @map("awaiting_confirmation_at")
  escalatedAt            DateTime? @map("escalated_at")
  escalationNotifiedAt   DateTime? @map("escalation_notified_at")

  category     Category      @relation(fields: [categoryId], references: [id])
  location     Location      @relation(fields: [locationId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  reports      Report[]
  assignments  Assignment[]
  issueUpdates IssueUpdate[]
  attachments  Attachment[]
  feedbacks    Feedback[]

  @@index([status])
  @@index([departmentId])
  @@index([createdAt])
  @@index([categoryId])
  @@index([locationId])
  @@map("incidents")
}

model Report {
  id             String   @id @default(cuid())
  ticketNumber   String   @unique @map("ticket_number")
  reporterId     String   @map("reporter_id")
  incidentId     String   @map("incident_id")
  categoryId     String   @map("category_id")
  locationId     String   @map("location_id")
  systemNumber   Int?     @map("system_number")
  description    String
  priority       String   @default("MEDIUM")
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  reporter     User          @relation("ReporterReports", fields: [reporterId], references: [id])
  incident     Incident      @relation(fields: [incidentId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  location     Location      @relation(fields: [locationId], references: [id])
  attachments  Attachment[]
  issueUpdates IssueUpdate[]

  @@index([ticketNumber])
  @@map("reports")
}

model Assignment {
  id         String   @id @default(cuid())
  incidentId String   @map("incident_id")
  assignedTo String   @map("assigned_to")
  assignedBy String   @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")
  reason     String?

  incident Incident @relation(fields: [incidentId], references: [id])
  assignee User     @relation("AssignedToUser", fields: [assignedTo], references: [id])
  assigner User     @relation("AssignedByUser", fields: [assignedBy], references: [id])

  @@map("assignments")
}

model IssueUpdate {
  id         String   @id @default(cuid())
  incidentId String   @map("incident_id")
  reportId   String?  @map("report_id")
  updatedBy  String   @map("updated_by")
  oldStatus  String?  @map("old_status")
  newStatus  String?  @map("new_status")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id])
  report   Report?  @relation(fields: [reportId], references: [id])
  updater  User     @relation(fields: [updatedBy], references: [id])

  @@map("issue_updates")
}

model Attachment {
  id         String   @id @default(cuid())
  reportId   String?  @map("report_id")
  incidentId String?  @map("incident_id")
  filePath   String   @map("file_path")
  mime       String
  size       Int
  uploadedBy String   @map("uploaded_by")
  kind       String // evidence | resolution
  createdAt  DateTime @default(now()) @map("created_at")

  report   Report?   @relation(fields: [reportId], references: [id])
  incident Incident? @relation(fields: [incidentId], references: [id])
  uploader User      @relation(fields: [uploadedBy], references: [id])

  @@map("attachments")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String   @map("actor_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  metadata  String   @default("{}") // JSON string
  createdAt DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model Feedback {
  id         String   @id @default(cuid())
  incidentId String   @map("incident_id")
  reporterId String   @map("reporter_id")
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id])
  reporter User     @relation(fields: [reporterId], references: [id])

  @@unique([incidentId, reporterId])
  @@map("feedback")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  message   String
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

model Settings {
  key   String @id
  value String

  @@map("settings")
}

model TicketSequence {
  id      Int    @id @default(autoincrement())
  yearKey String @map("year_key")
  seq     Int    @default(0)

  @@unique([yearKey])
  @@map("ticket_sequences")
}
